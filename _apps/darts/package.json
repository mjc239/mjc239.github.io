{
  "name": "darts-aim-advisor",
  "private": true,
  "version": "1.0.0",
  "description": "Darts Aim Advisor: where to aim from any score in a 501 leg, for your standard",
  "type": "module",
  "scripts": {
    "build": "esbuild main.jsx --bundle --minify --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=../../apps/darts/app.js",
    "watch": "esbuild main.jsx --bundle --jsx=automatic --define:process.env.NODE_ENV='\"development\"' --outfile=../../apps/darts/app.js --watch",
    "serve": "python3 -m http.server 8000 --directory ../..",
    "tables": "python3 solver/export_tables.py && python3 solver/make_fixture.py",
    "test": "node test_engine.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
